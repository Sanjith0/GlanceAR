# Public deployment URL only. Empty means the labelled, in-memory sample walkthrough.
EXPO_PUBLIC_CONVEX_URL=

# Never put META_API_KEY here or in any EXPO_PUBLIC_* variable.
# Configure it only in your Convex deployment's server-side environment.

# Optional: a LOCAL Convex backend for real same-camera preview summaries (see README).
# Keep EXPO_PUBLIC_CONVEX_URL empty so the preview stays in sample-data mode.
EXPO_PUBLIC_DEMO_SUMMARY_URL=
